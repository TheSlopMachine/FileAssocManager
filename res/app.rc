1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "File Association Manager"
            VALUE "FileVersion",     "1.0.0"
            VALUE "InternalName",    "FileAssocManager"
            VALUE "OriginalFilename","FileAssocManager.exe"
            VALUE "ProductName",     "File Association Manager"
            VALUE "ProductVersion",  "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
